<nav aria-label="Pagination" class="flex justify-center mt-6">
    <div class="join">
        {% for p in 1..pageCount %}
            <a
                class="join-item btn{% if page == p %} btn-active{% endif %}"
                href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge(app.request.query.all|merge({'p': p}))) }}"
            >
                {{ p }}
            </a>
        {% endfor %}
    </div>
</nav>
